{"scripts":{"minify:css":"cleancss -o ./css/styles.min.css ./css/styles.css","minify:js":"terser ./js/script.js -o ./js/script.min.js","minify:html":"html-minifier --input-dir html --output-dir ./ --file-ext html --collapse-whitespace --remove-comments --minify-css true --minify-js true","build":"bun run minify:css && bun run minify:js && bun run minify:html","dev":"bun run build && http-server -p 8080 -c-1 --silent --proxy http://localhost:8080"},"dependencies":{"clean-css-cli":"^5.6.3","terser":"^5.37.0","html-minifier":"^4.0.0","http-server":"^14.1.1"}}