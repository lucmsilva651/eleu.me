{"scripts":{"minify:css":"cleancss -o ./css/styles.min.css ./css/styles.css","minify:js":"terser ./js/index.js -o ./js/index.min.js","minify:html":"html-minifier --input-dir html --output-dir ./ --file-ext html --collapse-whitespace --remove-comments --minify-css true --minify-js true","build":"bun run minify:css && bun run minify:js && bun run minify:html"},"devDependencies":{"@types/bun":"latest"},"peerDependencies":{"typescript":"^5.0.0"},"dependencies":{"clean-css-cli":"^5.6.3","terser":"^5.37.0","html-minifier":"^4.0.0"}}